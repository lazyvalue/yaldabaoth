                             && c.input_surface.compose().mode == EditMode::Insert;
                         let midturn_steer = c.turn_phase.is_awaiting()
                             && !c.input_surface.is_chatbox()
                             && !c.input_surface.compose().text().trim().is_empty();
                         compose_insert || midturn_steer
                     })
                     .unwrap_or(false)
                 }
